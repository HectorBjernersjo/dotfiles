#!/usr/bin/env bash

# Configuration
PERSONAL_DIR="/home/hector/HRM/hector"

# Validate we're in a git worktree
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: Not in a git worktree"
    exit 1
fi

WORKTREE_PATH=$(git rev-parse --show-toplevel)
EXCLUDE_FILE="$(git rev-parse --git-common-dir)/info/exclude"

echo "Setting up worktree at: $WORKTREE_PATH"

# ---------------------------------------------------------
# 1. Get changed files from personal directory and copy them
# ---------------------------------------------------------
echo "Getting changed files from $PERSONAL_DIR..."

cd "$PERSONAL_DIR" || exit 1
changed_files=$(git diff master... --name-only)

if [ -z "$changed_files" ]; then
    echo "No changed files found"
    exit 0
fi

echo "Copying files..."
while IFS= read -r file; do
    src="$PERSONAL_DIR/$file"
    dst="$WORKTREE_PATH/$file"
    
    if [ -f "$src" ]; then
        mkdir -p "$(dirname "$dst")"
        cp "$src" "$dst"
        echo "  Copied: $file"
    fi
done <<< "$changed_files"

cp $PERSONAL_DIR/parentsettings.config $WORKTREE_PATH/parentsettings.config

# ---------------------------------------------------------
# 2. Skip-worktree or ignore each file
# ---------------------------------------------------------
cd "$WORKTREE_PATH" || exit 1

echo "Configuring git to ignore changes..."
while IFS= read -r file; do
    # If file is tracked by git, use skip-worktree
    if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
        git update-index --skip-worktree "$file"
        echo "  Skip-worktree: $file"
    else
        # Untracked file - add to exclude
        if ! grep -Fxq "$file" "$EXCLUDE_FILE" 2>/dev/null; then
            echo "$file" >> "$EXCLUDE_FILE"
            echo "  Excluded: $file"
        fi
    fi
done <<< "$changed_files"

# ---------------------------------------------------------
# 3. Build steps
# ---------------------------------------------------------
echo "Running build steps..."

if [ -d "$WORKTREE_PATH/Flex.Net/Flex.Net.Web" ]; then
    echo "Running npm install and build..."
    cd "$WORKTREE_PATH/Flex.Net/Flex.Net.Web"
    npm install
    npm run build-prod
    
    # Skip package-lock.json if it changed
    if [ -f "package-lock.json" ]; then
        git update-index --skip-worktree "Flex.Net/Flex.Net.Web/package-lock.json" 2>/dev/null
    fi
fi

if [ -d "$WORKTREE_PATH/Flex.Net" ]; then
    echo "Running dotnet restore..."
    cd "$WORKTREE_PATH/Flex.Net"
    dotnet restore
fi

echo "Done!"
