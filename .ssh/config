# Personligt GitHub-konto (HectorBjernersjo) är default — allt jag synkar
# på den här maskinen ligger under det kontot.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_personal_github
    IdentitiesOnly yes

# Jobbkontot (HectorVisma / Flex). Använd genom att skriva
# git@github.com-flex:Org/repo.git som remote.
Host github.com-flex
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_flex_github
    IdentitiesOnly yes
