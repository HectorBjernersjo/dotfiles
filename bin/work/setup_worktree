#!/usr/bin/env bash
# Skapa (eller komplettera) en HRM jj-workspace ovanpå tweaks-committen (base).
#
#   setup_worktree <namn>            skapa ~/work/HRM/<namn> + symlinks + bygg
#   setup_worktree <namn> --no-build hoppa över npm/dotnet-stegen
#   setup_worktree                   kör bara setup i workspacen du står i
#
# Trackade tweaks (FeatureManager, SimpleSql, test-appsettings, .cursor-radering
# m.m.) kommer från "private: tweaks"-committen (bookmark: base) och följer med
# automatiskt. Creds/miljö ligger i env-vars via ~/.zshrc.local. Det här scriptet
# hanterar bara untracked personliga filer + byggsteg.
set -euo pipefail

HRM_DIR="$HOME/work/HRM"
PERSONAL_DIR="$HRM_DIR/personal"
MAIN_WS="$HRM_DIR/master"
BUILD=true

if [ "${2:-}" = "--no-build" ]; then BUILD=false; fi

if [ $# -ge 1 ] && [ "$1" != "--no-build" ]; then
    WS="$HRM_DIR/$1"
    if [ ! -d "$WS" ]; then
        (cd "$MAIN_WS" && jj workspace add "$WS" --name "$1" -r base)
    fi
else
    [ "${1:-}" = "--no-build" ] && BUILD=false
    WS=$(jj workspace root)
fi

echo "Setup av workspace: $WS"

# Tweaks-committen (bookmark: base) ska alltid ligga under workspacen. Nya
# workspaces skapas direkt på base ovan; en befintlig som sitter någon annanstans
# rebasas hit — hela den mutable stacken följer med. MAIN_WS undantas, den ska
# ligga kvar på master.
if [ "$WS" != "$MAIN_WS" ] &&
   [ -z "$(cd "$WS" && jj log --no-graph -r 'base & ::@' -T change_id)" ]; then
    echo "Rebasear ovanpå base (tweaks)..."
    (cd "$WS" && jj rebase -s 'roots(mutable() & ::@)' -d base)
fi

# Untracked personliga filer — symlinkade från PERSONAL_DIR, ignorerade via
# master/.git/info/exclude (delas av alla workspaces).
link() {
    mkdir -p "$WS/$(dirname "$1")"
    ln -sfn "$PERSONAL_DIR/$1" "$WS/$1"
    echo "  länk: $1"
}
# Övriga personliga symlinks (docs, http, .ignore m.fl.) är trackade i
# tweaks-committen och följer med automatiskt. Settings-filen med creds kan inte
# trackas (ignoreras av repots .gitignore) så den länkas här.
#
# En kvarlämnad parentsettings.config (gamla konventionen) får apparnas start
# att kasta, så en gammal länk tas alltid bort.
if [ -L "$WS/parentsettings.config" ]; then
    rm -f "$WS/parentsettings.config"
    echo "  bort: parentsettings.config (utfasad)"
fi
link Flex.Net/private.settings.jsonc

if $BUILD; then
    echo "npm install + build..."
    (cd "$WS/Flex.Net/Flex.Net.Web" && npm install && npm run build-prod)
    (cd "$WS" && jj restore Flex.Net/Flex.Net.Web/package-lock.json)

    echo "dotnet restore..."
    (cd "$WS/Flex.Net" && EnableWindowsTargeting=true dotnet restore)
fi

echo "Klart!"
