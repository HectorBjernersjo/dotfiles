#!/usr/bin/env bash

# Configuration
PERSONAL_DIR="/home/hector/work/HRM/hector"

# Validate we're in a git worktree
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: Not in a git worktree"
    exit 1
fi

WORKTREE_PATH=$(git rev-parse --show-toplevel)
EXCLUDE_FILE="$(git rev-parse --git-common-dir)/info/exclude"

echo "Setting up worktree at: $WORKTREE_PATH"

# ---------------------------------------------------------
# Helpers
# ---------------------------------------------------------

# Skip-worktree if tracked, otherwise add to .git/info/exclude
ignore_path() {
    local file="$1"
    if git -C "$WORKTREE_PATH" ls-files --error-unmatch "$file" >/dev/null 2>&1; then
        git -C "$WORKTREE_PATH" update-index --skip-worktree "$file"
        echo "  Skip-worktree: $file"
    else
        if ! grep -Fxq "$file" "$EXCLUDE_FILE" 2>/dev/null; then
            echo "$file" >> "$EXCLUDE_FILE"
            echo "  Excluded: $file"
        fi
    fi
}

# Copy a file from PERSONAL_DIR into the worktree and ignore it
copy_file() {
    local file="$1"
    local src="$PERSONAL_DIR/$file"
    local dst="$WORKTREE_PATH/$file"

    if [ ! -e "$src" ]; then
        echo "  Warning: source not found: $src"
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    echo "  Copied: $file"
    ignore_path "$file"
}

# Replace a path in the worktree with a symlink to PERSONAL_DIR and ignore it
symlink_path() {
    local file="$1"
    local src="$PERSONAL_DIR/$file"
    local dst="$WORKTREE_PATH/$file"

    if [ ! -e "$src" ]; then
        echo "  Warning: source not found: $src"
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    rm -rf "$dst"
    ln -s "$src" "$dst"
    echo "  Symlinked: $file"
    ignore_path "$file"
}

# ---------------------------------------------------------
# Files to set up (edit these lists as needed)
# ---------------------------------------------------------

# Files that should be copied (independent per worktree)
copy_file "parentsettings.config"

# Files/dirs that should be symlinked (shared across worktrees)
