#!/usr/bin/env bash
# Skapa (eller komplettera) en HRM feature-workspace under features/.
#
#   setup_worktree <slug>            ny feature: ~/work/HRM/features/<slug> + bygg
#   setup_worktree <slug> -r <rev>   arbetsträd för en BEFINTLIG feature-head
#   setup_worktree <slug> --no-build hoppa över npm/dotnet-stegen
#   setup_worktree                   kör bara setup i workspacen du står i
#
# Nya workspaces får en feature-root (tom, beskriven change direkt på master),
# med -r adopteras <rev> som head istället. Working copyn blir i båda fallen
# merge(head, base) — tweaks följer med i arbetsträdet men hamnar aldrig i
# stacken. Heads som inte redan finns i main-megamergen läggs in som förälder
# där (main blir stale, kör jj workspace update-stale där).
#
# Creds/miljö ligger i env-vars via ~/.zshrc.local. Det här scriptet hanterar
# untracked personliga filer + byggsteg; trackade tweaks kommer från
# base-committen via mergen.
set -euo pipefail

HRM_DIR="$HOME/work/HRM"
PERSONAL_DIR="$HRM_DIR/personal"
MAIN_WS="$HRM_DIR/master"
BUILD=true
SLUG=""
REV=""

while [ $# -gt 0 ]; do
    case "$1" in
        --no-build) BUILD=false ;;
        -r) REV=${2:?-r kräver en revision}; shift ;;
        *) SLUG=$1 ;;
    esac
    shift
done

if [ -n "$SLUG" ]; then
    WS="$HRM_DIR/features/$SLUG"
    if [ ! -d "$WS" ]; then
        if [ -n "$REV" ]; then
            # Adoptera en befintlig head. Måste resolva till exakt en change.
            root=$(cd "$MAIN_WS" && jj log --no-graph -r "$REV" -T 'change_id ++ "\n"')
            [ "$(printf '%s\n' "$root" | wc -l)" -eq 1 ] ||
                { echo "-r $REV matchar flera changes" >&2; exit 1; }
            (cd "$MAIN_WS" && jj workspace add "$WS" --name "$SLUG" -r "$root")
        else
            (cd "$MAIN_WS" && jj workspace add "$WS" --name "$SLUG" -r 'trunk()')
        fi
        # Absolut repo-pekare — den relativa default-pekaren bryts vid flytt.
        printf '%s' "$MAIN_WS/.jj/repo" > "$WS/.jj/repo"
        (
            cd "$WS"
            if [ -z "$REV" ]; then
                jj describe -m "$SLUG: (wip)"
                root=$(jj log --no-graph -r @ -T 'change_id')
            fi
            jj new "$root" base -m "$SLUG: arbetsträd (stacken + base). Changes härifrån squashas ner i stacken, hamnar aldrig i PR."
            # Lägg in featuren i main-megamergen om ingen förälder redan
            # täcker den (heden själv eller en descendant av den).
            if jj log --no-graph -r 'main@' -T '' >/dev/null 2>&1; then
                if [ -z "$(jj log --no-graph -r "($root):: & main@-" -T 'change_id')" ]; then
                    mapfile -t ps < <(jj log --no-graph -r 'main@-' -T 'change_id ++ "\n"')
                    args=()
                    for p in "${ps[@]}"; do args+=(-d "$p"); done
                    jj rebase -r 'main@' "${args[@]}" -d "$root"
                else
                    echo "  featuren finns redan i main-megamergen"
                fi
            else
                echo "  obs: ingen main-workspace hittad — featuren lades inte i megamergen"
            fi
        )
    fi
else
    WS=$(jj workspace root)
fi

echo "Setup av workspace: $WS"

# Untracked personliga filer — symlinkade från PERSONAL_DIR, ignorerade via
# master/.git/info/exclude (delas av alla workspaces).
link() {
    mkdir -p "$WS/$(dirname "$1")"
    ln -sfn "$PERSONAL_DIR/$1" "$WS/$1"
    echo "  länk: $1"
}
# Övriga personliga symlinks (docs, http, .ignore m.fl.) är trackade i
# tweaks-committen och följer med via mergen. Settings-filen med creds kan
# inte trackas (ignoreras av repots .gitignore) så den länkas här.
#
# En kvarlämnad parentsettings.config (gamla konventionen) får apparnas start
# att kasta, så en gammal länk tas alltid bort.
if [ -L "$WS/parentsettings.config" ]; then
    rm -f "$WS/parentsettings.config"
    echo "  bort: parentsettings.config (utfasad)"
fi
link Flex.Net/private.settings.jsonc

if $BUILD; then
    echo "npm install + build..."
    (cd "$WS/Flex.Net/Flex.Net.Web" && npm install && npm run build-prod)
    (cd "$WS" && jj restore Flex.Net/Flex.Net.Web/package-lock.json)

    echo "dotnet restore..."
    (cd "$WS/Flex.Net" && EnableWindowsTargeting=true dotnet restore)
fi

echo "Klart!"
